{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    // * the codebase predates WXT's strict default - loosened to keep parity
    "strict": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "e2e/**/*.ts", "wxt.config.ts", "playwright.config.ts", ".wxt/**/*"],
  "exclude": ["node_modules", "build", ".output"]
}
